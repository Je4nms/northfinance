# Copie este arquivo para .streamlit/secrets.toml e preencha.
# O secrets.toml está no .gitignore, então ele nunca vai para o GitHub.

# A "connection string" do Neon (começa com postgresql://)
database_url = "cole-a-connection-string-aqui"

# Código que os convidados digitam na primeira vez que entram
invite_code = "NORTE2026"

# Login com Google (dados do "cliente" criado no Google Cloud)
[auth]
# Precisa ser IDÊNTICO a um dos URIs de redirecionamento cadastrados no Google
redirect_uri = "https://northfinancebr.streamlit.app/oauth2callback"
# Uma frase longa e aleatória, usada para proteger o "cookie" do login
cookie_secret = "invente-uma-frase-bem-longa-e-aleatoria"
client_id = "cole-o-id-do-cliente.apps.googleusercontent.com"
client_secret = "cole-a-chave-secreta-do-cliente"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
