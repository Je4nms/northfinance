# Copie para .env.local (no seu computador) ou cadastre na Vercel (Settings → Environment Variables).
# O .env.local fica fora do Git.

# A mesma connection string do Neon da versão 1
DATABASE_URL="postgresql://..."

# Login com Google: os mesmos ID e chave do cliente "NorthFinance web" no Google Cloud
AUTH_GOOGLE_ID="....apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-..."

# Uma frase longa e aleatória que protege o cookie do login (gere com: npx auth secret)
AUTH_SECRET="..."
